<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.20348.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release</Configurations>
    <ArcGISProInstallDir Condition="'$(ArcGISProInstallDir)' == ''">$(ProgramW6432)\ArcGIS\Pro</ArcGISProInstallDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Maps\**" />
    <EmbeddedResource Remove="Maps\**" />
    <None Remove="Maps\**" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Conversion/S57/S57_CoastlineA.cs" />
    <Compile Remove="Conversion/S57/S57_CoastlineL.cs" />
    <Compile Remove="Conversion/S57/S57_CoastlineP.cs" />
    <Compile Remove="Conversion/S57/S57_DangersA.cs" />
    <Compile Remove="Conversion/S57/S57_DangersL.cs" />
    <Compile Remove="Conversion/S57/S57_DangersP.cs" />
    <Compile Remove="Conversion/S57/S57_DepthsA.cs" />
    <Compile Remove="Conversion/S57/S57_DepthsL.cs" />
    <Compile Remove="Conversion/S57/S57_MetadataA.cs" />
    <Compile Remove="Conversion/S57/S57_MetadataP.cs" />
    <Compile Remove="Conversion/S57/S57_MilitaryFeaturesA.cs" />
    <Compile Remove="Conversion/S57/S57_MilitaryFeaturesP.cs" />
    <Compile Remove="Conversion/S57/S57_NaturalFeaturesA.cs" />
    <Compile Remove="Conversion/S57/S57_NaturalFeaturesL.cs" />
    <Compile Remove="Conversion/S57/S57_NaturalFeaturesP.cs" />
    <Compile Remove="Conversion/S57/S57_OffshoreInstallationsA.cs" />
    <Compile Remove="Conversion/S57/S57_OffshoreInstallationsL.cs" />
    <Compile Remove="Conversion/S57/S57_OffshoreInstallationsP.cs" />
    <Compile Remove="Conversion/S57/S57_RegulatedAreasAndLimitsA.cs" />
    <Compile Remove="Conversion/S57/S57_RegulatedAreasAndLimitsL.cs" />
    <Compile Remove="Conversion/S57/S57_RegulatedAreasAndLimitsP.cs" />
    <Compile Remove="Conversion/S57/S57_SeabedA.cs" />
    <Compile Remove="Conversion/S57/S57_SeabedL.cs" />
    <Compile Remove="Conversion/S57/S57_SeabedP.cs" />
    <Compile Remove="Conversion/S57/S57_TidesAndVariationsA.cs" />
    <Compile Remove="Conversion/S57/S57_TidesAndVariationsL.cs" />
    <Compile Remove="Conversion/S57/S57_TidesAndVariationsP.cs" />
    <Compile Remove="Conversion/S57/S57_TracksAndRoutesA.cs" />
    <Compile Remove="Conversion/S57/S57_TracksAndRoutesL.cs" />
    <Compile Remove="Conversion/S57/S57_TracksAndRoutesP.cs" />
    <Compile Remove="Application/State/Bridges.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="s100ed12.gdb.zip" />
    <None Remove="s100ed12.geodatabase" />
    <None Remove="s100ed13.geodatabase" />
    <None Remove="s100ed14.geodatabase" />
    <None Remove="s100ed15.geodatabase" />
    <None Remove="s100ed16.geodatabase" />
    <None Remove="s100ed17.geodatabase" />
    <None Remove="s100ed8.gdb.zip" />
    <None Remove="s100ed9.gdb.zip" />
    <None Remove="s100edX.gdb.zip" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="NetTopologySuite.IO.GeoJSON" Version="4.0.0" />
    <PackageReference Include="S100Framework.ArcGIS.Core" Version="3.7.1901.31" />
    <PackageReference Include="S100Framework.Catalogues" Version="4.1.1" />
    <PackageReference Include="S100Framework.Catalogues.ProductSpecifications" Version="4.1.1" />
    <PackageReference Include="S100Framework.GML" Version="3.1.8" />
    <PackageReference Include="S100Framework.YAML" Version="3.7.1901.11" />
    <PackageReference Include="Serilog.Enrichers.ExceptionData" Version="1.0.0" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="ArcGIS.Core">
      <HintPath>$(ArcGISProInstallDir)\bin\ArcGIS.Core.dll</HintPath>
    </Reference>
    <Reference Include="ArcGIS.CoreHost">
      <HintPath>$(ArcGISProInstallDir)\bin\ArcGIS.CoreHost.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <None Update="coverage.gdb.zip">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="coverage.geodatabase">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="coverage.zip">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="s100ed18.geodatabase">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="scamin.gdb.zip">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <Target Name="ValidateArcGISInstallation" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(ArcGISProInstallDir)/bin/ArcGIS.Core.dll')">
    <Error Text="ArcGIS Pro is required. Set ArcGISProInstallDir to the installed ArcGIS Pro directory." />
  </Target>
</Project>